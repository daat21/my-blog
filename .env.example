# Directory holding the site content. Defaults to the bundled sample content.
# Point it at a local clone of the content repository to work with real posts.
CONTENT_DIR=

# Public URL of the site. Detected automatically on Vercel.
SITE_URL=

# Runtime text source. Defaults to github on Vercel Production/Preview,
# filesystem for local development and CI. GitHub mode needs a build baseline.
# CONTENT_SOURCE=filesystem
# CONTENT_REPO=owner/content-repo
# CONTENT_REPO_REF=main
# Read-only Contents token, server-side at build time AND runtime.
# CONTENT_REPO_TOKEN=
# At least 64 random hexadecimal characters; match the publishing Action secret.
# CONTENT_REVALIDATE_SECRET=
# Local rehearsal only: loopback HTTP origin, rejected on Vercel.
# CONTENT_GITHUB_API_URL=http://127.0.0.1:3221
