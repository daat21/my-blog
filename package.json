{
  "name": "my-blog",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.20.0"
}
